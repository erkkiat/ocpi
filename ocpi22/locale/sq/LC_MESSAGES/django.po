#: choices.py:77
msgid "Available"
msgstr "Në dispozicion"

#: choices.py:78
msgid "Preparing"
msgstr "Përgatitja"

#: choices.py:79
msgid "Charging"
msgstr "Ngarkimi"

#: choices.py:80
msgid "Suspended by vehicle"
msgstr "I pezulluar me automjet"

#: choices.py:81
msgid "Suspended by charger"
msgstr "I pezulluar nga karikuesi"

#: choices.py:82
msgid "Finishing"
msgstr "Përfundimi"

#: choices.py:83
msgid "Reserved"
msgstr "Rezervuar"

#: choices.py:84
msgid "Unavailable"
msgstr "I padisponueshëm"

#: choices.py:85
msgid "Out of order"
msgstr "Jashtë përdorimit"

#: choices.py:165
msgid "Preparing to charge"
msgstr "Përgatitja për të ngarkuar"

#: choices.py:166
msgid "Stopping charging session"
msgstr "Ndalimi i seancës së karikimit"

#: choices.py:168
msgid "The charger is currently in use"
msgstr "Karikuesi është aktualisht në përdorim"

#: choices.py:170
msgid "Unable to start charging at this time"
msgstr "Nuk mund të fillojë karikimi në këtë moment"

#: choices.py:172
msgid "Unable to connect to charge point management system"
msgstr "Nuk mund të lidhet me sistemin e menaxhimit të pikës së karikimit"

#: choices.py:174
msgid "The token doesn't have enough balance on the account"
msgstr "Shenja nuk ka bilanc të mjaftueshëm në llogari"

#: choices.py:176
msgid "The token is accepted"
msgstr "Shenja pranohet"

#: choices.py:178
msgid "Your token is no longer valid"
msgstr "Shenja juaj nuk është më e vlefshme"

#: choices.py:180
#, fuzzy
#| msgid "Unable to connect to charge point management system"
msgid "There is a protocol error with the CPO charge point management system"
msgstr "Nuk mund të lidhet me sistemin e menaxhimit të pikës së karikimit"

#: choices.py:194
msgid "The reservation has been cancelled"
msgstr "Rezervimi është anuluar"

#: choices.py:195 choices.py:199
msgid "The charger is inoperative"
msgstr "Karikuesi nuk funksionon"

#: choices.py:196
msgid "Failed to start the charging"
msgstr "Fillimi i karikimit dështoi"

#: choices.py:197
msgid "The operation is not supported by the charger"
msgstr "Operacioni nuk mbështetet nga karikuesi"

#: choices.py:198
msgid "The command was rejected by the charger"
msgstr "Komanda u refuzua nga karikuesi"

#: choices.py:200
msgid "There has been a problem with the reservation"
msgstr "Ka pasur një problem me rezervimin"

#: models/session.py:172
msgid "Active"
msgstr "Aktiv"

#: models/session.py:176
msgid "Completed"
msgstr "E përfunduar"

#: models/session.py:179
msgid "Invalid"
msgstr "E pavlefshme"

#: models/session.py:183
msgid "Pending"
msgstr "Në pritje"

#: models/session.py:187
msgid "Reservation"
msgstr "Rezervimi"

#: msp/user.py:64
msgid "The current password doesn't match"
msgstr "Fjalëkalimi aktual nuk përputhet"

#: msp/user.py:66 msp/user.py:144
