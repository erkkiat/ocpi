#: choices.py:171
msgid "Preparing to charge"
msgstr "Pasiruošimas įkrauti"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Sustabdoma įkrovimo sesija"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Šiuo metu įkroviklis naudojamas"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Šiuo metu negalima pradėti krauti"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Nepavyko prisijungti prie įkrovimo taškų valdymo sistemos"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Žetono sąskaitoje nepakanka likučio"

#: choices.py:182
msgid "The token is accepted"
msgstr "Žetonas priimtas"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Jūsų prieigos raktas nebegalioja"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Rezervacija atšaukta"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Įkroviklis neveikia"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Nepavyko pradėti įkrovimo"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Įkroviklis nepalaiko operacijos"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Įkroviklis komandą atmetė"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Iškilo rezervavimo problema"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Slaptažodis ir patvirtinimas skiriasi vienas nuo kito"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Automobilio modelis {car_id} duomenų bazėje nerastas"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Naudotojas {email} jau yra"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Slaptažodis sėkmingai pakeistas"
