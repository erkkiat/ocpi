#: choices.py:77
msgid "Available"
msgstr "Ar fáil"

#: choices.py:78
msgid "Preparing"
msgstr "ag ullmhú"

#: choices.py:79
msgid "Charging"
msgstr "Muirearú"

#: choices.py:80
msgid "Suspended by vehicle"
msgstr "Ar fionraí i bhfeithicil"

#: choices.py:81
msgid "Suspended by charger"
msgstr "Ar fionraí ag charger"

#: choices.py:82
msgid "Finishing"
msgstr "Ag críochnú"

#: choices.py:83
msgid "Reserved"
msgstr "Curtha in áirithe"

#: choices.py:84
msgid "Unavailable"
msgstr "Níl fáil air"

#: choices.py:85
msgid "Out of order"
msgstr "As ord"

#: choices.py:165
msgid "Preparing to charge"
msgstr "Ag ullmhú chun muirear"

#: choices.py:166
msgid "Stopping charging session"
msgstr "Seisiún luchtaithe a stopadh"

#: choices.py:168
msgid "The charger is currently in use"
msgstr "Tá an charger in úsáid faoi láthair"

#: choices.py:170
msgid "Unable to start charging at this time"
msgstr "Ní féidir tús a chur le muirearú faoi láthair"

#: choices.py:172
msgid "Unable to connect to charge point management system"
msgstr "Ní féidir ceangal le córas bainistíochta na bpointí luchtaithe"

#: choices.py:174
msgid "The token doesn't have enough balance on the account"
msgstr "Níl go leor iarmhéid ar an gcuntas ar an chomhartha"

#: choices.py:176
msgid "The token is accepted"
msgstr "Glactar leis an comhartha"

#: choices.py:178
msgid "Your token is no longer valid"
msgstr "Níl do chomhartha bailí a thuilleadh"

#: choices.py:180
#, fuzzy
#| msgid "Unable to connect to charge point management system"
msgid "There is a protocol error with the CPO charge point management system"
msgstr "Ní féidir ceangal le córas bainistíochta na bpointí luchtaithe"

#: choices.py:194
msgid "The reservation has been cancelled"
msgstr "Cuireadh an áirithint ar ceal"

#: choices.py:195 choices.py:199
msgid "The charger is inoperative"
msgstr "Tá an charger neamhoibríoch"

#: choices.py:196
msgid "Failed to start the charging"
msgstr "Theip ar an muirearú a thosú"

#: choices.py:197
msgid "The operation is not supported by the charger"
msgstr "Ní thacaíonn an charger leis an oibríocht"

#: choices.py:198
msgid "The command was rejected by the charger"
msgstr "Dhiúltaigh an charger don ordú"

#: choices.py:200
msgid "There has been a problem with the reservation"
msgstr "Bhí fadhb leis an áirithint"

#: models/session.py:172
msgid "Active"
msgstr "Gníomhach"

#: models/session.py:176
msgid "Completed"
msgstr "Críochnaithe"

#: models/session.py:179
msgid "Invalid"
msgstr "Neamhbhailí"

#: models/session.py:183
msgid "Pending"
msgstr "Ar feitheamh"

#: models/session.py:187
msgid "Reservation"
msgstr "Áirithint"

#: msp/user.py:64
msgid "The current password doesn't match"
msgstr "Ní hionann an pasfhocal reatha"

#: msp/user.py:66 msp/user.py:144
msgid "Password and confirm differ from each other"
msgstr "Pasfhocal agus a dhearbhú difriúil óna chéile"

