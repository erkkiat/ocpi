#, python-brace-format
msgid "The user {email} already exists"
msgstr "Tá an t-úsáideoir {email} ann cheana"

#: msp/user.py:292
msgid "Password has been changed successfully"
msgstr "Athraíodh an pasfhocal go rathúil"

