#: choices.py:171
msgid "Preparing to charge"
msgstr "Prepararsi a caricare"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Interruzione della sessione di ricarica"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Il caricatore è attualmente in uso"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Impossibile avviare la ricarica in questo momento"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Impossibile connettersi al sistema di gestione dei punti di ricarica"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Il token non ha abbastanza saldo sul conto"

#: choices.py:182
msgid "The token is accepted"
msgstr "Il token è accettato"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Il tuo token non è più valido"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "La prenotazione è stata cancellata"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Il caricatore non è operativo"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Impossibile avviare la ricarica"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "L'operazione non è supportata dal caricatore"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Il comando è stato rifiutato dal caricatore"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Si è verificato un problema con la prenotazione"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Password e conferma differiscono tra loro"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Modello di auto {car_id} non trovato dal database"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "L'utente {email} esiste già"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "La password è stata modificata correttamente"
