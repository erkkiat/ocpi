#: choices.py:171
msgid "Preparing to charge"
msgstr "preparándose para cargar"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Deteniendo la sesión de carga"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "El cargador está actualmente en uso"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "No se puede iniciar la carga en este momento"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "No se puede conectar al sistema de gestión de puntos de recarga"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "El token no tiene suficiente saldo en la cuenta"

#: choices.py:182
msgid "The token is accepted"
msgstr "Se acepta la ficha"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Su token ya no es válido"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "La reserva ha sido cancelada."

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "El cargador no funciona"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "No se pudo iniciar la carga"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "La operación no es compatible con el cargador."

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "El comando fue rechazado por el cargador."

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Ha habido un problema con la reserva."

#: msp/user.py:56 msp/user.py:143
