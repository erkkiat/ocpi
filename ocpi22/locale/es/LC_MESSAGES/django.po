msgstr "Modelo de coche {car_id} no encontrado en la base de datos"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "El usuario {email} ya existe"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "La contraseña ha sido cambiada con éxito"
