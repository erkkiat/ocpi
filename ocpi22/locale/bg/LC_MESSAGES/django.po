#: choices.py:171
msgid "Preparing to charge"
msgstr "Подготовка за зареждане"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Спиране на сесията на зареждане"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "В момента зарядното устройство се използва"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "В момента не може да започне зареждането"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr ""
"Не може да се свърже със системата за управление на точките на зареждане"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Токенът няма достатъчно баланс по сметката"

#: choices.py:182
msgid "The token is accepted"
msgstr "Токенът е приет"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Вашият токен вече не е валиден"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Резервацията е анулирана"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Зарядното устройство не работи"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Неуспешно стартиране на зареждането"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Операцията не се поддържа от зарядното устройство"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Командата беше отхвърлена от зарядното устройство"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Възникна проблем с резервацията"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Парола и потвърждение се различават един от друг"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Моделът на автомобил {car_id} не е намерен от базата данни"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Потребителят {email} вече съществува"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Паролата е променена успешно"
