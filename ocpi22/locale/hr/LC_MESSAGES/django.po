#: choices.py:171
msgid "Preparing to charge"
msgstr "Priprema za punjenje"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Zaustavljanje sesije punjenja"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Punjač je trenutno u upotrebi"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "U ovom trenutku nije moguće započeti punjenje"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Nije moguće povezati se sa sustavom upravljanja točkama punjenja"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Token nema dovoljno stanja na računu"

#: choices.py:182
msgid "The token is accepted"
msgstr "Token je prihvaćen"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Vaš token više nije valjan"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Rezervacija je otkazana"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Punjač ne radi"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Pokretanje punjenja nije uspjelo"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Punjač ne podržava rad"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Naredbu je odbio punjač"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Došlo je do problema s rezervacijom"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Lozinka i potvrda razlikuju se"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Model automobila {car_id} nije pronađen u bazi podataka"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Korisnik {email} već postoji"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Lozinka je uspješno promijenjena"
