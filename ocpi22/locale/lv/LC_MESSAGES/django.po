#: choices.py:171
msgid "Preparing to charge"
msgstr "Gatavošanās uzlādei"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Uzlādes sesijas pārtraukšana"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Lādētājs pašlaik tiek lietots"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Šobrīd nevar sākt uzlādi"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Nevar izveidot savienojumu ar uzlādes punktu pārvaldības sistēmu"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Marķiera kontā nav pietiekami daudz atlikuma"

#: choices.py:182
msgid "The token is accepted"
msgstr "Žetons ir pieņemts"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Jūsu marķieris vairs nav derīgs"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Rezervācija ir atcelta"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Lādētājs nedarbojas"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Neizdevās sākt uzlādi"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Lādētājs šo darbību neatbalsta"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Lādētājs komandu noraidīja"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Ir radusies problēma ar rezervāciju"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Parole un apstiprinājums atšķiras viens no otra"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Automašīnas modelis {car_id} datubāzē nav atrasts"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Lietotājs {email} jau pastāv"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Parole ir veiksmīgi nomainīta"
