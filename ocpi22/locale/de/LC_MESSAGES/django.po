#: choices.py:171
msgid "Preparing to charge"
msgstr "Ladevorgang vorbereiten"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Beenden der Ladesitzung"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Das Ladegerät wird derzeit verwendet"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Der Ladevorgang kann derzeit nicht gestartet werden"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr ""
"Es kann keine Verbindung zum Ladepunkt-Verwaltungssystem hergestellt werden"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Der Token hat nicht genug Guthaben auf dem Konto"

#: choices.py:182
msgid "The token is accepted"
msgstr "Der Token wird akzeptiert"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Ihr Token ist nicht mehr gültig"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Die Reservierung wurde storniert"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Das Ladegerät funktioniert nicht"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Der Ladevorgang konnte nicht gestartet werden"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Der Betrieb wird vom Ladegerät nicht unterstützt"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Der Befehl wurde vom Ladegerät abgelehnt"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Bei der Reservierung ist ein Problem aufgetreten"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Passwort und Bestätigung unterscheiden sich voneinander"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
