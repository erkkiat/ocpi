msgid "Car model {car_id} not found from database"
msgstr "Fahrzeugmodell {car_id} nicht in Datenbank gefunden"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Der Benutzer {email} existiert bereits"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Passwort wurde erfolgreich geändert"
