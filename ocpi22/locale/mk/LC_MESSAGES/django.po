#: choices.py:171
msgid "Preparing to charge"
msgstr "Подготовка за полнење"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Запирање на сесијата за полнење"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Полначот моментално се користи"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Не може да започне полнењето во овој момент"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Не може да се поврзе со системот за управување со точките за полнење"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Токенот нема доволно салдо на сметката"

#: choices.py:182
msgid "The token is accepted"
msgstr "Токенот е прифатен"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Вашиот токен повеќе не е валиден"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Резервацијата е откажана"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Полначот не работи"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Не успеа да започне полнењето"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Операцијата не е поддржана од полначот"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Командата беше одбиена од полначот"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Имаше проблем со резервацијата"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Лозинката и потврдата се разликуваат едни од други"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Моделот на автомобилот {car_id} не е пронајден од базата на податоци"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Корисникот {email} веќе постои"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Лозинката е успешно променета"
