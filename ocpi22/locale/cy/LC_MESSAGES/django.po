#: choices.py:165
msgid "Preparing to charge"
msgstr "Paratoi i godi tâl"

#: choices.py:166
msgid "Charger is reserved for you"
msgstr "Mae charger wedi'i gadw i chi"

#: choices.py:167
msgid "Stopping charging session"
msgstr "Rhoi'r gorau i sesiwn codi tâl"

#: choices.py:169
msgid "The charger is currently in use"
msgstr "Mae'r charger yn cael ei ddefnyddio ar hyn o bryd"

#: choices.py:171
msgid "Unable to start charging at this time"
msgstr "Methu dechrau codi tâl ar hyn o bryd"

#: choices.py:173
msgid "Unable to connect to charge point management system"
msgstr "Methu cysylltu â system rheoli pwyntiau gwefru"

#: choices.py:175
msgid "The token doesn't have enough balance on the account"
msgstr "Nid oes gan y tocyn ddigon o falans ar y cyfrif"

#: choices.py:177
msgid "The token is accepted"
msgstr "Derbynnir y tocyn"

#: choices.py:179
msgid "Your token is no longer valid"
msgstr "Nid yw eich tocyn yn ddilys bellach"

#: choices.py:181
#, fuzzy
#| msgid "Unable to connect to charge point management system"
msgid "There is a protocol error with the CPO charge point management system"
msgstr "Methu cysylltu â system rheoli pwyntiau gwefru"

#: choices.py:196
msgid "The reservation has been cancelled"
msgstr "Mae'r archeb wedi'i chanslo"

#: choices.py:197 choices.py:201
msgid "The charger is inoperative"
msgstr "Mae'r charger yn anweithredol"

#: choices.py:198
msgid "Failed to start the charging"
msgstr "Wedi methu cychwyn y codi tâl"

#: choices.py:199
msgid "The operation is not supported by the charger"
msgstr "Ni chefnogir y llawdriniaeth gan y charger"

#: choices.py:200
msgid "The command was rejected by the charger"
msgstr "Gwrthodwyd y gorchymyn gan y charger"

#: choices.py:202
msgid "There has been a problem with the reservation"
msgstr "Bu problem gyda'r archeb"

