#: choices.py:77
msgid "Available"
msgstr "Διαθέσιμος"

#: choices.py:78
msgid "Preparing"
msgstr "Προετοιμασία"

#: choices.py:79
msgid "Charging"
msgstr "Φόρτιση"

#: choices.py:80
msgid "Suspended by vehicle"
msgstr "Αναρτάται με όχημα"

#: choices.py:81
msgid "Suspended by charger"
msgstr "Αναρτάται από φορτιστή"

#: choices.py:82
msgid "Finishing"
msgstr "Φινίρισμα"

#: choices.py:83
msgid "Reserved"
msgstr "Κατοχυρωμένα"

#: choices.py:84
msgid "Unavailable"
msgstr "Μη διαθέσιμο"

#: choices.py:85
msgid "Out of order"
msgstr "Εκτός λειτουργίας"

#: choices.py:165
msgid "Preparing to charge"
msgstr "Προετοιμασία για φόρτιση"

#: choices.py:166
msgid "Stopping charging session"
msgstr "Διακοπή περιόδου λειτουργίας φόρτισης"

#: choices.py:168
msgid "The charger is currently in use"
msgstr "Ο φορτιστής χρησιμοποιείται αυτήν τη στιγμή"

#: choices.py:170
msgid "Unable to start charging at this time"
msgstr "Δεν είναι δυνατή η έναρξη της φόρτισης αυτήν τη στιγμή"

#: choices.py:172
msgid "Unable to connect to charge point management system"
msgstr "Δεν είναι δυνατή η σύνδεση στο σύστημα διαχείρισης σημείου φόρτισης"

#: choices.py:174
msgid "The token doesn't have enough balance on the account"
msgstr "Το διακριτικό δεν έχει αρκετό υπόλοιπο στον λογαριασμό"

#: choices.py:176
msgid "The token is accepted"
msgstr "Το διακριτικό γίνεται αποδεκτό"

#: choices.py:178
msgid "Your token is no longer valid"
msgstr "Το διακριτικό σας δεν είναι πλέον έγκυρο"

#: choices.py:192
msgid "The reservation has been cancelled"
msgstr "Η κράτηση ακυρώθηκε"

#: choices.py:193 choices.py:197
msgid "The charger is inoperative"
msgstr "Ο φορτιστής δεν λειτουργεί"

#: choices.py:194
msgid "Failed to start the charging"
msgstr "Η έναρξη της φόρτισης απέτυχε"

#: choices.py:195
msgid "The operation is not supported by the charger"
msgstr "Η λειτουργία δεν υποστηρίζεται από το φορτιστή"

#: choices.py:196
msgid "The command was rejected by the charger"
msgstr "Η εντολή απορρίφθηκε από τον φορτιστή"

#: choices.py:198
msgid "There has been a problem with the reservation"
msgstr "Παρουσιάστηκε πρόβλημα με την κράτηση"

#: models/session.py:171
msgid "Active"
msgstr "Ενεργός"

#: models/session.py:175
msgid "Completed"
msgstr "Ολοκληρώθηκε το"

#: models/session.py:178
msgid "Invalid"
msgstr "Μη έγκυρο"

#: models/session.py:182
msgid "Pending"
msgstr "εκκρεμής"

#: models/session.py:186
msgid "Reservation"
msgstr "Κράτηση"

#: msp/user.py:63
msgid "The current password doesn't match"
msgstr "Ο τρέχων κωδικός πρόσβασης δεν ταιριάζει"

#: msp/user.py:65 msp/user.py:143
