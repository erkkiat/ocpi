#: choices.py:171
msgid "Preparing to charge"
msgstr "Przygotowanie do ładowania"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Zatrzymywanie sesji ładowania"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Ładowarka jest obecnie w użyciu"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "W tej chwili nie można rozpocząć ładowania"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Nie można połączyć się z systemem zarządzania punktami ładowania"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Token nie ma wystarczającego salda na koncie"

#: choices.py:182
msgid "The token is accepted"
msgstr "Token jest akceptowany"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Twój token jest już nieważny"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Rezerwacja została anulowana"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Ładowarka nie działa"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Nie udało się rozpocząć ładowania"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Operacja nie jest obsługiwana przez ładowarkę"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Polecenie zostało odrzucone przez ładowarkę"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Wystąpił problem z rezerwacją"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Hasło i potwierdzenie różnią się od siebie"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Nie znaleziono modelu samochodu {car_id} w bazie danych"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Użytkownik {email} już istnieje"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Hasło zostało pomyślnie zmienione"
