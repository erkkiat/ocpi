#: choices.py:171
msgid "Preparing to charge"
msgstr "Forbereder lading"

#: choices.py:172
msgid "Stopping charging session"
msgstr "Stopper ladeøkten"

#: choices.py:174
msgid "The charger is currently in use"
msgstr "Laderen er for øyeblikket i bruk"

#: choices.py:176
msgid "Unable to start charging at this time"
msgstr "Kan ikke starte lading nå"

#: choices.py:178
msgid "Unable to connect to charge point management system"
msgstr "Kan ikke koble til administrasjonssystemet for ladepunkt"

#: choices.py:180
msgid "The token doesn't have enough balance on the account"
msgstr "Tokenet har ikke nok saldo på kontoen"

#: choices.py:182
msgid "The token is accepted"
msgstr "Tokenet er akseptert"

#: choices.py:184
msgid "Your token is no longer valid"
msgstr "Tokenet ditt er ikke lenger gyldig"

#: choices.py:197
msgid "The reservation has been cancelled"
msgstr "Reservasjonen er kansellert"

#: choices.py:198 choices.py:202
#| msgid "The charger is currently in use"
msgid "The charger is inoperative"
msgstr "Laderen er ute av drift"

#: choices.py:199
#| msgid "Unable to start charging at this time"
msgid "Failed to start the charging"
msgstr "Kunne ikke starte ladingen"

#: choices.py:200
msgid "The operation is not supported by the charger"
msgstr "Operasjonen støttes ikke av laderen"

#: choices.py:201
msgid "The command was rejected by the charger"
msgstr "Kommandoen ble avvist av laderen"

#: choices.py:203
msgid "There has been a problem with the reservation"
msgstr "Det har vært et problem med reservasjonen"

#: msp/user.py:56 msp/user.py:143
msgid "Password and confirm differ from each other"
msgstr "Passord og bekreftelse skiller seg fra hverandre"

#: msp/user.py:99 msp/user.py:133 msp/user.py:340
#, python-brace-format
msgid "Car model {car_id} not found from database"
msgstr "Bilmodell {car_id} ikke funnet fra databasen"

#: msp/user.py:252
#, python-brace-format
msgid "The user {email} already exists"
msgstr "Brukeren {email} eksisterer allerede"

#: msp/user.py:284
msgid "Password has been changed successfully"
msgstr "Passordet er endret"
