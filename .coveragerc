[run]
omit = */migrations/*
       */settings/*
       */tests/*
       *test_*.py
       *_test.py
       */test.py
       test.py
       wsgi.py
       */conftest.py
       .venv/*
       venv/*
       manage.py
       */admin.py
       */__init__.py
       */base_task_services.py
       */testutil.py
       */terraform/*

[report]
omit = */migrations/*
       */settings/*
       */tests/*
       *test_*.py
       *_test.py
       */test.py
       test.py
       wsgi.py
       */conftest.py
       .venv/*
       venv/*
       manage.py
       */admin.py
       */__init__.py
       */base_task_services.py
       */testutil.py
       */terraform/*

exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
